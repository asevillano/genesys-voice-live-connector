# =============================================================================
# Dockerfile for TypeScript Voice Agent
# Azure Container Apps deployment with Voice Live API and Cosmos DB integration
# =============================================================================

# ---------- Stage 1: Build ----------
FROM node:18 AS builder

WORKDIR /app

# Copy package files and install ALL dependencies (including devDependencies for build)
COPY package*.json ./
RUN npm ci

# Copy source code
COPY tsconfig.json ./
COPY src/typescript ./src/typescript

# Build TypeScript to JavaScript
RUN npm run build

# ---------- Stage 2: Runtime ----------
FROM node:18-slim

WORKDIR /app

# Create a non-root user for security
RUN groupadd -r appgroup && useradd -r -g appgroup appuser

# Copy package files and install only production dependencies
COPY package*.json ./
RUN npm ci --omit=dev

# Copy compiled JavaScript from builder
COPY --from=builder /app/dist ./dist

# Copy prompts folder (needed at runtime)
COPY src/typescript/prompts ./src/typescript/prompts

# Set ownership
RUN chown -R appuser:appgroup /app

# Switch to non-root user
USER appuser

# Expose the application port
EXPOSE 8081

# =============================================================================
# Required Environment Variables (set in Azure Container Apps):
# -----------------------------------------------------------------------------
# Voice Live API:
#   AZURE_VOICE_LIVE_ENDPOINT    - Azure AI Services endpoint
#   AZURE_VOICE_LIVE_API_KEY     - API Key for Voice Live
#   AZURE_VOICE_LIVE_VOICE       - Voice name (e.g., es-ES-XimenaNeural)
#   VOICE_LIVE_MODEL             - Model name (e.g., gpt-realtime)
#
# Cosmos DB (for invoice queries):
#   COSMOS_ENDPOINT              - Cosmos DB endpoint URL
#   COSMOS_KEY                   - Cosmos DB access key
#   COSMOS_DATABASE_NAME         - Database name
#   COSMOS_CONTAINER_NAME        - Container name
#
# Application:
#   PORT                         - Server port (default: 8081)
#   BOT_PROVIDER                 - Provider type (voicelive, openai, deepgram)
# =============================================================================

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD node -e "require('http').get('http://localhost:8081/health', (r) => process.exit(r.statusCode === 200 ? 0 : 1)).on('error', () => process.exit(1))" || exit 1

# Start the compiled application
CMD ["node", "dist/index.js"]
