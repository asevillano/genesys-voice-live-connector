# ============= NGrok Configuration (for local development) =============
NGROK_AUTHTOKEN=<NGROK Auth Token>
NGROK_STATIC_URL=<NGROK Static URL>

# ============= Voice Live API Configuration (Recommended) =============
# Use BOT_PROVIDER=voicelive to enable Azure Speech voices
AZURE_VOICE_LIVE_ENDPOINT=https://<your-resource>.services.ai.azure.com/
AZURE_VOICE_LIVE_API_KEY=<Azure Voice Live API Key>
VOICE_LIVE_MODEL=gpt-realtime
AZURE_VOICE_LIVE_API_VERSION=2025-10-01
# Voice options for Voice Live (Azure Speech voices):
# - Spanish: es-ES-Ximena:DragonHDLatestNeural, es-ES-AlvaroNeural
# - English: en-US-Ava:DragonHDLatestNeural, en-US-JennyNeural
AZURE_VOICE_LIVE_VOICE=es-ES-Ximena:DragonHDLatestNeural

# ============= Azure OpenAI Realtime API Configuration (Alternative) =============
# Option 1: Full endpoint URL
# Preview: wss://{resource}.openai.azure.com/openai/realtime?api-version=2024-10-01-preview&deployment={deployment}
# GA: wss://{resource}.openai.azure.com/openai/v1/realtime?model={deployment}
OPENAI_MODEL_ENDPOINT=wss://<your-resource>.openai.azure.com/openai/v1/realtime?model=gpt-realtime
OPENAI_API_KEY=<Azure OpenAI API Key>
# Native GPT Realtime voices: alloy, echo, shimmer, ash, ballad, coral, sage, verse
OPENAI_VOICE_ID=alloy

# ============= Deepgram Configuration (Alternative) =============
DEEPGRAM_API_KEY=<Deepgram API Key>
DEEPGRAM_ENDPOINT=wss://agent.deepgram.com/v1/agent/converse
DEEPGRAM_LISTEN_MODEL=nova-2-phonecall
DEEPGRAM_THINK_PROVIDER_TYPE=open_ai
DEEPGRAM_THINK_PROVIDER_MODEL=gpt-4o-mini
DEEPGRAM_SPEAK_VOICE=aura-asteria-en

# ============= Azure Cosmos DB Configuration (Optional) =============
COSMOS_ENDPOINT=https://<your-cosmosdb>.documents.azure.com:443/
COSMOS_KEY=<Cosmos DB Primary Key>
COSMOS_DATABASE_NAME=<Database Name>
COSMOS_CONTAINER_NAME=<Container Name>

# ============= General Configuration =============
PORT=8081
# BOT_PROVIDER options: voicelive, openai, deepgram
# Use 'voicelive' for Azure Speech voices (recommended)
BOT_PROVIDER=voicelive
MAX_BINARY_MESSAGE_SIZE=64000
MIN_BINARY_MESSAGE_SIZE=8000
NO_INPUT_TIMEOUT=15000
NO_INPUT_MESSAGE=User did not provide any input. Act accordingly.
DEFAULT_PROMPT_INSTRUCTIONS=You are a helpful assistant. Please answer the user's questions to the best of your ability.
INITIAL_GREETING=Greet the user warmly and ask how you can help them today.
