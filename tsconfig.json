{
    "compilerOptions": {
      "rootDir": "src/typescript",
      "outDir": "dist",
      "sourceMap": true,
  
      "lib": ["ES2021"],
      "module": "commonjs",
      "target": "ES2021",
  
      "strict": true,
      "esModuleInterop": true,
      "forceConsistentCasingInFileNames": true
    },
    "include": ["src/typescript/**/*"],
    "exclude": ["node_modules", "dist", "src/python"]
  }
